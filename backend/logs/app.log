Hibernate: 
    SELECT
        j.id as id,
        j.title as title,
        c.name as companyName,
        c.image as companyLogo,
        et.name as employmentType,
        CONCAT(w.name, ', ', p.name) as location,
        j.salary as salaryRange,
        j.created_at as createdAt     
    FROM
        job j     
    JOIN
        company c 
            ON j.company_id = c.id     
    JOIN
        employment_type et 
            on j.employment_type_id = et.id     
    JOIN
        wards w 
            ON j.ward_code = w.code     
    JOIN
        provinces p 
            ON w.province_code = p.code     
    WHERE
        j.is_featured = true     
    ORDER BY
        j.created_at DESC     
    LIMIT
        8 
