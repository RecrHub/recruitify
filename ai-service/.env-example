# LLM — NVIDIA integrate API (OpenAI-compatible)
# Lấy key tại https://build.nvidia.com → chọn model → "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional override
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=z-ai/glm-5.2

# Embeddings (HuggingFace — chạy local, không cần key)
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma vector DB
# CHROMA_DIR=./chroma_db
